# WXT Environment Variables
# Copy this file to .env and customize as needed
# Note: Changes to this file require restarting the dev server

# API Endpoints
# URL for the Supadata/YouTube Transcript API
WXT_TRANSCRIPT_API_URL=https://youtube-transcript-generator-five.vercel.app/simple-transcript

# URL for the Jina/URL Retrieval API
# URL for the Jina/URL Retrieval API
WXT_RETRIEVE_API_URL=https://youtube-transcript-generator-five.vercel.app/retrieve

# URL for Metadata API (Vercel)
WXT_METADATA_API_URL=https://youtube-transcript-generator-five.vercel.app/metadata

# Feature Flags
# Set to 'false' to enable Local LLM features in the UI (requires Ollama/Chrome AI)
# Default: true (Hides local mode to simplify UI for general users)
WXT_HIDE_LOCAL_MODE=true

# Set to 'false' to disable auto-prefetching of YouTube transcripts
# Default: true (Prefetches for faster UX)
WXT_YOUTUBE_BADGE_PREFETCH=true

# Logging Configuration
# Available Presets:
# - DEVELOPMENT: Most logs, good for general dev
# - VERBOSE: All logs enabled
# - DEBUG_MCP: Focused on MCP client/server
# - DEBUG_VOICE: Focused on ElevenLabs/Voice
# - DEBUG_TOOLS: Focused on Tool execution
# - DEBUG_WORKFLOW: Focused on AI Workflows
# - QUIET: Minimal logs
# - PRODUCTION: Errors only
WXT_LOG_PRESET=DEVELOPMENT
