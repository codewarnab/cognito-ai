{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "build/**",
                "dist/**",
                ".next/**",
                ".output/**"
            ]
        },
        "package": {
            "dependsOn": [
                "build"
            ],
            "outputs": [
                ".output/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "type:check": {
            "dependsOn": [
                "^build"
            ]
        },
        "lint": {
            "dependsOn": [
                "^build"
            ]
        },
        "deploy": {
            "dependsOn": [
                "build"
            ]
        },
        "clean": {
            "cache": false
        }
    }
}