+            sanitizeLatex: module.sanitizeLatex,
+            sanitizeForLatexOnline: module.sanitizeForLatexOnline,
+            validateLatex: module.validateLatex,
+        };
+        _testUtils = module._testUtils;
+        console.log('✅ Loaded sanitizer from compiled dist/');
+    } catch (e) {
+        console.error('❌ Failed to load sanitizer. Run "pnpm build" first.');
+        console.error('   Error:', e.message);
+        process.exit(1);
+    }
+}
+
+// =============================================================================
+// Test Cases
+// =============================================================================
+
+function runTests() {
+    // -------------------------------------------------------------------------
+    // Unit Tests for Individual Functions
+    // -------------------------------------------------------------------------
+
+    describe('removeUnsupportedCommands', () => {
+        const { removeUnsupportedCommands } = _testUtils;
