{
  "name": "@cognito/cli-bridge",
  "version": "0.1.0",
  "description": "Local bridge server connecting CLI coding agents (Gemini CLI, Claude Code, Codex CLI) to Cognito Chrome extension tools",
  "type": "module",
  "main": "./dist/cli.js",
  "module": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "bin": {
    "cognito-bridge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type:check": "tsc",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "cognito",
    "cli",
    "bridge",
    "mcp",
    "ai",
    "gemini",
    "claude",
    "codex",
    "chrome-extension"
  ],
  "author": "Cognito AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewarnab/cognito-ai.git",
    "directory": "packages/cli-bridge"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@cognito/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "ai": "catalog:",
    "ai-sdk-provider-claude-code": "^3.2.1",
    "ai-sdk-provider-codex-cli": "^1.0.4",
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}