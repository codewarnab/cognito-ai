{
    "name": "@cognito/shared",
    "version": "0.0.1",
    "description": "Shared types and constants for Cognito AI",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.js"
        },
        "./constants": {
            "types": "./dist/constants/index.d.ts",
            "import": "./dist/constants/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    }
}