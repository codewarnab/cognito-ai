{
  "name": "cognito-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Cognito AI - Privacy-first AI Browser Agent monorepo",
  "author": "dev@codewarnab.in",
  "license": "BUSL-1.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @cognito/extension dev",
    "dev:docs": "pnpm --filter @cognito/docs dev",
    "dev:webapp": "pnpm --filter @cognito/webapp dev",
    "dev:bridge": "pnpm --filter @cognito/code-bridge dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:extension": "pnpm --filter @cognito/extension build",
    "build:docs": "pnpm --filter @cognito/docs build",
    "build:webapp": "pnpm --filter @cognito/webapp build",
    "package:extension": "pnpm --filter @cognito/extension package",
    "deploy:cloudflare": "pnpm --filter @cognito/backend-cloudflare deploy",
    "type:check": "pnpm -r type:check",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rimraf node_modules"
  },
  "devDependencies": {
    "browserify-zlib": "^0.2.0",
    "https-browserify": "^1.0.0",
    "path-browserify": "^1.0.0",
    "rimraf": "^6.0.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.1.0",
    "url": "^0.11.0",
    "util": "^0.12.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "next-themes": "^0.4.6"
  }
}