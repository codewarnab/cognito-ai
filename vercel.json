{
    "version": 2,
    "builds": [
        {
            "src": "packages/backend-vercel/api/index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "packages/backend-vercel/dist/**",
                    "packages/shared/dist/**",
                    "packages/shared/package.json",
                    "node_modules/@cognito/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/packages/backend-vercel/api/index.js"
        }
    ],
    "installCommand": "pnpm install --ignore-scripts",
    "buildCommand": "pnpm --filter @cognito/shared build && pnpm --filter @cognito/backend-vercel run vercel-build"
}